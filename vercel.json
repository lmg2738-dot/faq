{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.env,.env.*,__pycache__/**,.venv/**,venv/**,*.ps1,*.bat,install_startup.ps1,uninstall_startup.ps1,build.ps1}"
    }
  }
}
